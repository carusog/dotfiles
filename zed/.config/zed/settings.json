// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "diff_view_style": "split",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "terminal": {
    "dock": "bottom"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "prettier": {
    "allowed": true,
  },
  "format_on_save": "on",
  "formatter": "prettier",
  "agent": {
    "dock": "left",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5",
    },
    "model_parameters": [],
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "tabs": {
    "show_diagnostics": "all",
  },
  "ssh_connections": [
    {
      "host": "github.com",
      "projects": [],
    },
  ],
  "icon_theme": "Colored Zed Icons Theme Light",
  "theme": "Catppuccin Macchiato",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  // "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_family": "CaskaydiaCove Nerd Font Mono",
  "base_keymap": "VSCode",
}
